# Основные секреты. Сгенерируйте scripts/generate-secrets.sh или scripts/setup-windows.ps1.
PANEL_ADMIN_PASSWORD=REPLACE_ME
PANEL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
PANEL_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

PORT=3000
DATA_DIR=data
CERT_DIR=certs
HTTPS_ENABLED=true
COOKIE_SECURE=true
TRUST_PROXY=0
POLL_INTERVAL_MS=15000
HISTORY_INTERVAL_MS=60000
HISTORY_RETENTION_DAYS=30

# Linux/WSL2 + Docker overlay: /run/ssh-agent.sock
# Нативный Windows: \\.\pipe\openssh-ssh-agent
SSH_AUTH_SOCK=
HOST_SSH_AUTH_SOCK=

# Для Windows PowerShell setup создаёт PFX и заполняет эти поля.
# На Linux/Docker их можно оставить пустыми: контейнер создаст panel.key/panel.crt через OpenSSL.
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=

PANEL_UID=1000
PANEL_GID=1000
# PANEL_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... panel@host
