#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE="${MFP_CONFIG:-/etc/monero-farm-panel/mfp.conf}"
if [[ -f "$CONFIG_FILE" ]]; then # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi
MFP_DIR="${MFP_DIR:-}"
MFP_IMAGE="${MFP_IMAGE:-ghcr.io/ktololp/monero-farm-panel}"
MFP_CONTAINER="${MFP_CONTAINER:-monero-farm-panel}"
MFP_PORT="${MFP_PORT:-3000}"
MFP_UID="${MFP_UID:-1000}"
MFP_GID="${MFP_GID:-1000}"
MFP_REPO="${MFP_REPO:-Ktololp/monero-farm-panel}"
MFP_KIOSK_FILE="${MFP_KIOSK_FILE:-}"

[[ -n "$MFP_DIR" ]] || { echo 'MFP_DIR is not configured. Run scripts/install-mfp.sh first.' >&2; exit 2; }
ENV_FILE="$MFP_DIR/.env"; DATA_DIR="$MFP_DIR/data"; CERT_DIR="$MFP_DIR/certs"; BACKUP_DIR="$MFP_DIR/backups"; STATE_DIR="$MFP_DIR/state"
mkdir -p "$BACKUP_DIR" "$STATE_DIR"

if docker info >/dev/null 2>&1; then D=(docker); elif command -v sudo >/dev/null 2>&1; then D=(sudo docker); else echo 'Docker is not accessible.' >&2; exit 2; fi
log(){ printf '[mfp] %s\n' "$*"; }
die(){ printf '[mfp] ERROR: %s\n' "$*" >&2; exit 1; }
container_exists(){ "${D[@]}" inspect "$MFP_CONTAINER" >/dev/null 2>&1; }
container_running(){ [[ "$("${D[@]}" inspect -f '{{.State.Running}}' "$MFP_CONTAINER" 2>/dev/null || true)" == true ]]; }
current_image(){ "${D[@]}" inspect -f '{{.Config.Image}}' "$MFP_CONTAINER" 2>/dev/null || true; }
current_version(){ "${D[@]}" exec "$MFP_CONTAINER" node -p "require('./package.json').version" 2>/dev/null || true; }
run_container(){ local image="$1"; local args=(run -d --name "$MFP_CONTAINER" --restart unless-stopped --user "$MFP_UID:$MFP_GID" --env-file "$ENV_FILE" -p "$MFP_PORT:3000" -v "$DATA_DIR:/app/data" -v "$CERT_DIR:/app/certs"); if [[ -n "${MFP_SSH_AUTH_SOCK:-}" ]]; then args+=(-v "$MFP_SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent); fi; args+=("$image"); "${D[@]}" "${args[@]}" >/dev/null; }
health(){ local proto=https; grep -Eq '^HTTPS_ENABLED=(0|false|no|off)$' "$ENV_FILE" 2>/dev/null && proto=http; curl -ksSf "$proto://127.0.0.1:$MFP_PORT/healthz" >/dev/null; }
wait_health(){ local i; for i in $(seq 1 30); do health && return 0; sleep 2; done; return 1; }
latest_version(){ local json tag; json=$(curl -fsSL -H 'Accept: application/vnd.github+json' -H 'User-Agent: Monero-Farm-Panel-Updater/1.1.0' "https://api.github.com/repos/$MFP_REPO/releases/latest") || return 1; tag=$(printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1); tag="${tag#v}"; [[ "$tag" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1; printf '%s\n' "$tag"; }
backup(){ local stamp out was=0; stamp=$(date +%Y%m%d-%H%M%S); out="$BACKUP_DIR/mfp-$stamp.tar.gz"; if container_running; then was=1; "${D[@]}" stop -t 20 "$MFP_CONTAINER" >/dev/null; fi; tar -C "$MFP_DIR" -czf "$out" --ignore-failed-read .env data certs state 2>/dev/null || { [[ $was == 1 ]] && "${D[@]}" start "$MFP_CONTAINER" >/dev/null || true; return 1; }; [[ $was == 1 ]] && "${D[@]}" start "$MFP_CONTAINER" >/dev/null; printf '%s\n' "$out"; }
restore_archive(){ local archive="$1"; [[ -f "$archive" ]] || die "Backup not found: $archive"; container_running && "${D[@]}" stop -t 20 "$MFP_CONTAINER" >/dev/null || true; tar -C "$MFP_DIR" -xzf "$archive"; container_exists && "${D[@]}" start "$MFP_CONTAINER" >/dev/null || true; }
sync_source(){ [[ -d "$MFP_DIR/.git" ]] || return 0; [[ -z "$(git -C "$MFP_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]] || { log 'Source checkout has local changes; runtime updated but git pull skipped.'; return 0; }; git -C "$MFP_DIR" fetch origin main --quiet >/dev/null 2>&1 || return 0; git -C "$MFP_DIR" checkout main --quiet >/dev/null 2>&1 || return 0; git -C "$MFP_DIR" pull --ff-only --quiet >/dev/null 2>&1 || true; }

cmd_status(){ local v image running healths; v=$(current_version); image=$(current_image); running=$(container_running && echo running || echo stopped); healths=$(health 2>/dev/null && echo OK || echo FAIL); printf 'Monero Farm Panel\n\nVersion:   %s\nImage:     %s\nContainer: %s\nHealth:    %s\nAddress:   https://localhost:%s\nData:      %s\n' "${v:-unknown}" "${image:-none}" "$running" "$healths" "$MFP_PORT" "$MFP_DIR"; }
cmd_update(){ local target="${1:-}" old_image old_backup new_image; [[ -f "$ENV_FILE" ]] || die "Missing $ENV_FILE"; if [[ -z "$target" ]]; then log 'Checking latest stable GitHub Release…'; target=$(latest_version) || die 'Could not determine latest stable release.'; fi; [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'Version must look like 1.1.0'; new_image="$MFP_IMAGE:$target"; old_image=$(current_image); log "Current: ${old_image:-none}"; log "Target:  $new_image"; if [[ "$(current_version)" == "$target" && "$old_image" == "$new_image" ]]; then log 'Already up to date.'; return 0; fi; log 'Pulling new image while the current panel is still online…'; "${D[@]}" pull "$new_image"; log 'Creating consistent backup…'; old_backup=$(backup) || die 'Backup failed; update aborted.'; log "Backup: $old_backup"; printf '%s\n' "$old_image" > "$STATE_DIR/previous-image"; printf '%s\n' "$old_backup" > "$STATE_DIR/previous-backup"; printf '%s\n' "$target" > "$STATE_DIR/target-version"; container_running && "${D[@]}" stop -t 20 "$MFP_CONTAINER" >/dev/null || true; container_exists && "${D[@]}" rm "$MFP_CONTAINER" >/dev/null || true; log 'Starting new version…'; if run_container "$new_image" && wait_health; then printf '%s\n' "$target" > "$STATE_DIR/current-version"; log "Update successful: $target"; sync_source; return 0; fi; log 'Health check failed. Rolling back…'; container_running && "${D[@]}" stop -t 10 "$MFP_CONTAINER" >/dev/null || true; container_exists && "${D[@]}" rm "$MFP_CONTAINER" >/dev/null || true; restore_archive "$old_backup"; if [[ -n "$old_image" ]]; then container_exists && "${D[@]}" rm "$MFP_CONTAINER" >/dev/null || true; run_container "$old_image"; wait_health || die 'Rollback container started but health check still fails.'; fi; die 'Update failed; previous version restored.'; }
cmd_rollback(){ local image archive; image=$(cat "$STATE_DIR/previous-image" 2>/dev/null || true); archive=$(cat "$STATE_DIR/previous-backup" 2>/dev/null || true); [[ -n "$image" && -n "$archive" ]] || die 'No previous update state is available.'; [[ -f "$archive" ]] || die "Rollback backup missing: $archive"; log "Rolling back to $image"; container_running && "${D[@]}" stop -t 20 "$MFP_CONTAINER" >/dev/null || true; container_exists && "${D[@]}" rm "$MFP_CONTAINER" >/dev/null || true; tar -C "$MFP_DIR" -xzf "$archive"; run_container "$image"; wait_health || die 'Rollback health check failed.'; log 'Rollback completed.'; }
cmd_backup(){ local out; out=$(backup) || die 'Backup failed.'; log "Backup created: $out"; }
cmd_restore(){ [[ $# -eq 1 ]] || die 'Usage: mfp restore /path/to/backup.tar.gz'; restore_archive "$1"; log 'Backup restored.'; }
cmd_restart(){ "${D[@]}" restart "$MFP_CONTAINER" >/dev/null; wait_health || die 'Panel did not become healthy after restart.'; log 'Restarted.'; }
cmd_logs(){ "${D[@]}" logs --tail "${1:-200}" -f "$MFP_CONTAINER"; }
cmd_kiosk(){ local action="${1:-}"; [[ -n "$MFP_KIOSK_FILE" ]] || die 'MFP_KIOSK_FILE is not configured.'; case "$action" in on) [[ -f "$MFP_KIOSK_FILE.disabled" ]] && mv "$MFP_KIOSK_FILE.disabled" "$MFP_KIOSK_FILE"; log 'Kiosk autostart enabled.';; off) [[ -f "$MFP_KIOSK_FILE" ]] && mv "$MFP_KIOSK_FILE" "$MFP_KIOSK_FILE.disabled"; log 'Kiosk autostart disabled.';; *) die 'Usage: mfp kiosk on|off';; esac; }
cmd_uninstall(){ [[ "${1:-}" == '--confirm' ]] || die 'This removes the container and /usr/local/bin/mfp but keeps data. Re-run: mfp uninstall --confirm'; container_running && "${D[@]}" stop -t 20 "$MFP_CONTAINER" >/dev/null || true; container_exists && "${D[@]}" rm "$MFP_CONTAINER" >/dev/null || true; log 'Container removed. Persistent .env/data/certs were kept.'; [[ -w /usr/local/bin ]] && rm -f /usr/local/bin/mfp || log 'Remove /usr/local/bin/mfp with sudo if desired.'; }
usage(){ cat <<'TXT'
Usage: mfp <command>
  status                 Show version/image/health
  update [1.2.3]         Update to latest stable release or an exact version
  rollback               Restore image + data from the previous update
  backup                 Create a consistent backup
  restore FILE           Restore a backup archive
  logs [LINES]           Follow container logs
  restart                Restart and health-check the panel
  kiosk on|off           Toggle configured kiosk autostart
  uninstall --confirm    Remove runtime container/CLI, keep persistent data
TXT
}
case "${1:-}" in status) cmd_status;; update) shift; cmd_update "${1:-}";; rollback) cmd_rollback;; backup) cmd_backup;; restore) shift; cmd_restore "$@";; logs) shift; cmd_logs "${1:-200}";; restart) cmd_restart;; kiosk) shift; cmd_kiosk "${1:-}";; uninstall) shift; cmd_uninstall "${1:-}";; help|-h|--help|'') usage;; *) usage; exit 2;; esac
